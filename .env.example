# Copy to .env and fill in. Never commit .env.
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required
POSTGRES_PASSWORD=
REPORT_ENGINE_API_KEY=
# n8n uses this to encrypt stored credentials. Keep it: losing it makes them unreadable.
N8N_ENCRYPTION_KEY=

# Optional: without it the Claude call fails and the report uses the rule-based summary.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Report
REPORT_LOCALE=pt-BR
REPORT_SENDER=ops-reports@example.com
REPORT_RECIPIENTS=ops-team@example.com
ALERT_RECIPIENTS=ops-oncall@example.com
# Minutes a person takes to build this report by hand. Measure yours; used for "hours saved".
MANUAL_REPORT_MINUTES=90

# SMTP. Defaults point to the local Mailpit container (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_DISABLE_STARTTLS=true
